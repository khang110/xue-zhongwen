# Đăng nhập bằng Google OAuth (1 người dùng duy nhất, xem README mục Cài đặt)
# Tạo Client ID/Secret tại: https://console.cloud.google.com/apis/credentials
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=

# Chỉ email này mới được phép đăng nhập
NUXT_ALLOWED_GOOGLE_EMAIL=

# Session cookie secret cho nuxt-auth-utils, toi thieu 32 ky tu
# Tao moi bang: node -e "console.log(require('node:crypto').randomBytes(24).toString('hex'))"
NUXT_SESSION_PASSWORD=
